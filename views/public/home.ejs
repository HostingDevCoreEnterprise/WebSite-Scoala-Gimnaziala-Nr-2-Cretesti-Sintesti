<%- include('../partials/head') %>
<%- include('../partials/header', { currentPage: 'home' }) %>

<main>
  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-blob hero-blob-1"></div>
      <div class="hero-blob hero-blob-2"></div>
      <div class="hero-blob hero-blob-3"></div>
      <div class="hero-dots"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Școală Gimnazială · Creței-Sintești
      </div>
      <h1 class="hero-title">
        <span class="grad-text">Bun venit la Școala Gimnazială Nr. 2</span>
      </h1>
      <p class="hero-sub">Creței-Sintești — o comunitate dedicată educației și formării elevilor noștri.</p>
      <div class="hero-actions">
        <a href="/anunturi"  class="btn btn-primary btn-lg"> Anunțuri</a>
        <a href="#despre-noi" class="btn btn-secondary btn-lg">Despre Noi</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">
      <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
      <span>Derulează</span>
    </div>
  </section>

  <!-- ── STATS ── -->
  <section class="section-sm">
    <div class="container">
      <div class="stats-bar reveal">
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="320">0</span>
          <span class="stat-label">Elevi</span>
        </div>
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="28">0</span>
          <span class="stat-label">Cadre Didactice</span>
        </div>
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="8">0</span>
          <span class="stat-label">Clase</span>
        </div>
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="50">0</span>
          <span class="stat-label">Ani de Activitate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section" id="despre-noi">
    <div class="container">
      <div class="about-grid">
        <div class="about-img-wrap reveal">
          <div class="about-img" style="background-image: url('/images/scoala_actuala_1782732694274.png'); background-size: cover; background-position: center;" aria-label="Școala Noastră" role="img"></div>
        </div>
        <div class="reveal reveal-delay-1">
          <p class="section-label">Despre noi</p>
          <h2 class="section-title">Despre Noi</h2>
          <div class="about-text" style="margin-top:20px;">
            <div class="rich-content"><p>Școala Gimnazială Nr. 2 Creței-Sintești este o instituție de învățământ preuniversitar cu tradiție în comunitate, dedicată formării elevilor cu valori solide și competențe moderne.</p></div>
          </div>
          <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/profesori" class="btn btn-primary">Profesori</a>
            <a href="/elevi"     class="btn btn-secondary">Elevi</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── LATEST ANNOUNCEMENTS ── -->
  <% if (announcements.length > 0) { %>
  <section class="section" style="background:var(--p50);padding-top:80px;padding-bottom:80px;">
    <div class="container">
      <div class="section-head centered">
        <p class="section-label">Noutăți</p>
        <h2 class="section-title">Ultimele <span class="accent">Anunțuri</span></h2>
        <p class="section-desc">Fii la curent cu cele mai recente informații de la școala noastră.</p>
      </div>
      <div class="grid-3">
        <% announcements.forEach((ann, i) => { %>
        <div class="card ann-card priority-<%= ann.priority %> reveal reveal-delay-<%= i+1 %>">
          <div class="card-body">
            <div class="ann-meta">
              <span class="ann-date">
                <%= new Date(ann.published_at).toLocaleDateString('ro-RO', { day:'numeric', month:'long', year:'numeric' }) %>
              </span>
              <span class="badge badge-<%= ann.priority %>"><%= ann.priority === 'urgent' ? 'Urgent' : ann.priority === 'important' ? 'Important' : 'Normal' %></span>
            </div>
            <h3 class="ann-title"><%= ann.title %></h3>
            <p class="ann-excerpt"><%= ann.content.replace(/<[^>]*>/g,'') %></p>
          </div>
        </div>
        <% }) %>
      </div>
      <div style="text-align:center;margin-top:40px;">
        <a href="/anunturi" class="btn btn-outline btn-lg">Vezi toate anunțurile →</a>
      </div>
    </div>
  </section>
  <% } %>
</main>

<%- include('../partials/footer', { settings }) %>
