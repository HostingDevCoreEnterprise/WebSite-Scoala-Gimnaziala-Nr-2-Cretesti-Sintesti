<%- include('../partials/head') %>
<%- include('../partials/header', { currentPage: 'home' }) %>

<main>
  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-blob hero-blob-1"></div>
      <div class="hero-blob hero-blob-2"></div>
      <div class="hero-blob hero-blob-3"></div>
      <div class="hero-dots"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        Școala Gimnazială Crețești
      </div>
      <h1 class="hero-title">
        <span class="grad-text">Bun venit la Școala Gimnazială Nr. 2</span>
      </h1>
      <p class="hero-sub" style="font-weight: 500; font-size: 1.25rem; line-height: 1.8; text-shadow: 1px 1px 3px rgba(0,0,0,0.3);">
        Învăţăm pentru a şti.<br>
        Învăţăm pentru a face.<br>
        Învăţăm pentru a fi.<br>
        Învăţăm pentru a deveni activi în comunitate.
      </p>
      <div class="hero-actions">
        <a href="/anunturi"  class="btn btn-primary btn-lg"> Anunțuri</a>
        <a href="#despre-noi" class="btn btn-secondary btn-lg">Despre Noi</a>
      </div>
    </div>
    <div class="hero-scroll" aria-hidden="true">
      <div class="scroll-mouse"><div class="scroll-wheel"></div></div>
      <span>Derulează</span>
    </div>
  </section>

  <!-- ── STATS ── -->
  <section class="section-sm">
    <div class="container">
      <div class="stats-bar reveal">
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="530">0</span>
          <span class="stat-label">Elevi</span>
        </div>
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="35">0</span>
          <span class="stat-label">Cadre Didactice</span>
        </div>
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="21">0</span>
          <span class="stat-label">Clase</span>
        </div>
        <div class="stat-item">
          <span class="stat-num grad-text" data-target="57">0</span>
          <span class="stat-label">Ani de Activitate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section" id="despre-noi">
    <div class="container">
      <div class="about-grid">
        <div class="about-img-wrap reveal">
          <div class="about-img" style="background-image: url('/images/scoala_actuala_1782732694274.png'); background-size: cover; background-position: center;" aria-label="Școala Noastră" role="img"></div>
        </div>
        <div class="reveal reveal-delay-1">
          <p class="section-label">Despre noi</p>
          <h2 class="section-title">Despre Noi</h2>
          <div class="about-text" style="margin-top:20px;">
            <div class="rich-content"><p>Școala Gimnazială Nr. 2 Crețești este o instituție de învățământ preuniversitar cu tradiție în comunitate, dedicată formării elevilor cu valori solide și competențe moderne.</p></div>
          </div>
          <div style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap;">
            <a href="/profesori" class="btn btn-primary">Profesori</a>
            <a href="/elevi"     class="btn btn-secondary">Elevi</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── VIZIUNE ȘI MISIUNE ── -->
  <section class="section" style="background:var(--bg2);">
    <div class="container">
      <div class="section-head centered">
        <p class="section-label">Valori și Obiective</p>
        <h2 class="section-title">Viziune & <span class="accent">Misiune</span></h2>
      </div>
      <div class="grid-2" style="gap: 40px; margin-bottom: 40px; align-items: stretch;">
        <div class="card" style="padding: 30px; box-shadow: var(--sh-md); height: 100%;">
          <h3 style="color: var(--p700); margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
            Viziune
          </h3>
          <p style="color: var(--text2); line-height: 1.7; font-size: 1.05rem;">
            Şcoala Gimnazială nr. 2 Crețești își propune să devină o şcoală modernă, dinamică, mereu deschisă tuturor copiilor indiferent de etnie, situație materială și socială.
          </p>
          <p style="color: var(--text2); line-height: 1.7; margin-top: 15px;"><strong>Pentru a îndeplini această viziune, ne dorim:</strong></p>
          <ul style="color: var(--text2); line-height: 1.7; padding-left: 20px; margin-top: 10px;">
            <li style="margin-bottom: 10px;">să creăm un mediu incluziv în care fiecare copil se simte liber, apreciat și în siguranță.</li>
            <li style="margin-bottom: 10px;">să oferim oportunități prin care elevii să-şi dezvolte armonios personalitatea și creativitatea.</li>
            <li style="margin-bottom: 10px;">să îi îndrumăm cu pasiune pentru a-şi descoperi și valorifica pe deplin talentele personale.</li>
            <li style="margin-bottom: 10px;">să îi pregătim temeinic pentru piața muncii, formând tineri capabili să se adapteze la schimbările viitorului.</li>
          </ul>
        </div>
        <div class="card" style="padding: 30px; box-shadow: var(--sh-md); height: 100%;">
          <h3 style="color: var(--p700); margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            Misiune
          </h3>
          <p style="color: var(--text2); line-height: 1.7; font-size: 1.05rem;">
            Şcoala Gimnazială nr. 2 Crețești este o instituţie care asigură dezvoltarea complexă a tuturor elevilor, pentru integrarea într-o societate mereu în schimbare, prin transmiterea cunoștințelor, formarea competențelor şi aptitudinilor viitorului, formarea atitudinilor, credinţelor şi valorilor democratice.
          </p>
          <p style="color: var(--text2); line-height: 1.7; margin-top: 15px;"><strong>Pentru aceasta, şcoala noastră îşi propune:</strong></p>
          <ul style="color: var(--text2); line-height: 1.7; padding-left: 20px; margin-top: 10px;">
            <li style="margin-bottom: 10px;">să promoveze un învăţământ de calitate, modern, deschis spre schimbare şi inovare, spre valorile autentic europene.</li>
            <li style="margin-bottom: 10px;">să dezvolte un demers educativ, flexibil, centrat pe elev care să-i permită acestuia dezvoltarea personală şi deschiderea spre învăţarea pe tot parcursul vieţii.</li>
            <li style="margin-bottom: 10px;">să respecte şi să valorifice pozitiv diferenţele sociale, culturale, religioase, lingvistice, promovând toleranţa, nediscriminarea, lucrul în echipă şi echitatea în toate demersurile educative.</li>
            <li style="margin-bottom: 10px;">să întărească legătura cu familia, comunitatea şi partenerii sociali, în scopul dezvoltării unui mediu favorabil învățării, bazat pe valori morale pozitive, în care fiecare elev să beneficieze de șansa dezvoltării sale.</li>
          </ul>
        </div>
      </div>
      
      <!-- Quote block -->
      <div style="background: linear-gradient(135deg, var(--p800), var(--p900)); padding: 40px; border-radius: var(--r-lg); color: white; text-align: center; box-shadow: var(--sh-lg); margin-top: 40px; margin-bottom: 40px;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2" style="margin-bottom: 20px;"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path></svg>
        <p style="font-size: 1.5rem; font-style: italic; font-weight: 300; line-height: 1.6; max-width: 800px; margin: 0 auto;">
          "Educaţia nu înseamnă cât de mult ai reţinut şi nici măcar cât de multe cunoşti. Este capacitatea de a diferenţia între ceea ce ştii şi ceea ce nu ştii."
        </p>
        <p style="margin-top: 20px; font-weight: 600; font-size: 1.1rem; opacity: 0.9;">— Anatole France</p>
      </div>
    </div>
  </section>

  <!-- ── LATEST ANNOUNCEMENTS ── -->
  <% if (announcements.length > 0) { %>
  <section class="section" style="background:var(--p50);padding-top:80px;padding-bottom:80px;">
    <div class="container">
      <div class="section-head centered">
        <p class="section-label">Noutăți</p>
        <h2 class="section-title">Ultimele <span class="accent">Anunțuri</span></h2>
        <p class="section-desc">Fii la curent cu cele mai recente informații de la școala noastră.</p>
      </div>
      <div class="grid-3">
        <% announcements.forEach((ann, i) => { %>
        <div class="card ann-card priority-<%= ann.priority %> reveal reveal-delay-<%= i+1 %>">
          <div class="card-body">
            <div class="ann-meta">
              <span class="ann-date">
                <%= new Date(ann.published_at).toLocaleDateString('ro-RO', { day:'numeric', month:'long', year:'numeric' }) %>
              </span>
              <span class="badge badge-<%= ann.priority %>"><%= ann.priority === 'urgent' ? 'Urgent' : ann.priority === 'important' ? 'Important' : 'Normal' %></span>
            </div>
            <h3 class="ann-title"><%= ann.title %></h3>
            <p class="ann-excerpt"><%= ann.content.replace(/<[^>]*>/g,'') %></p>
            <% if (ann.photo_url) { %>
            <div style="margin-top:12px;">
              <img src="<%= ann.photo_url %>" alt="<%= ann.title %>" style="max-width: 100%; border-radius: 6px; display: block;" />
            </div>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <div style="text-align:center;margin-top:40px;">
        <a href="/anunturi" class="btn btn-outline btn-lg">Vezi toate anunțurile →</a>
      </div>
    </div>
  </section>
  <% } %>
</main>

<%- include('../partials/footer', { settings }) %>
