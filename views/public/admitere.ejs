<%- include('../partials/head') %>
<%- include('../partials/header', { currentPage: 'admitere' }) %>

<main>
  <section class="page-header" style="background: linear-gradient(135deg, var(--p800), var(--p900)); color: white; padding: 100px 0 60px;">
    <div class="container text-center">
      <h1 class="reveal">Procedură de Admitere</h1>
      <p class="reveal reveal-delay-1" style="font-size: 1.25rem; opacity: 0.9; max-width: 650px; margin: 20px auto 0;">
        Informații oficiale privind admiterea și înscrierea elevilor pentru anul școlar <%= stats ? stats.year : 'curent' %>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 860px;">

      <!-- Subnavigation Elevi -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; margin-bottom: 45px;">
        <a href="/elevi" class="btn btn-secondary"> Despre Elevi</a>
        <a href="/admitere" class="btn btn-primary"> Admitere</a>
        <a href="/statutul-elevului" class="btn btn-secondary"> Statutul Elevului</a>
        <a href="/activitati-extra" class="btn btn-secondary"> Activități Extracuriculare</a>
        <a href="/absolvire" class="btn btn-secondary"> Absolvire</a>
        <a href="/evaluare-nationala" class="btn btn-secondary"> Evaluare Națională</a>
      </div>
      
      <% if (stats) { %>
      <style>
        .admitere-stats {
          display: flex; 
          justify-content: center; 
          gap: 40px; 
          margin-bottom: 45px; 
          background: white; 
          padding: 30px; 
          border-radius: var(--r-xl); 
          box-shadow: var(--sh-md);
          border: 1px solid var(--p100);
        }
        .admitere-stats-divider {
          width: 2px; 
          background: var(--p100);
        }
        @media (max-width: 768px) {
          .admitere-stats {
            flex-direction: column;
            gap: 20px;
            padding: 20px;
          }
          .admitere-stats-divider {
            width: 100%;
            height: 2px;
          }
        }
      </style>
      <div class="admitere-stats">
        <div style="text-align: center;">
          <div style="font-size: 3rem; font-weight: 900; color: var(--p600);"><%= stats.total_seats %></div>
          <div style="font-size: 0.95rem; color: var(--text2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Locuri Totale</div>
        </div>
        <div class="admitere-stats-divider"></div>
        <div style="text-align: center;">
          <div style="font-size: 3rem; font-weight: 900; color: var(--s500);"><%= stats.occupied_seats %></div>
          <div style="font-size: 0.95rem; color: var(--text2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Locuri Ocupate</div>
        </div>
        <div class="admitere-stats-divider"></div>
        <div style="text-align: center;">
          <div style="font-size: 3rem; font-weight: 900; color: var(--success, #10b981);"><%= Math.max(0, stats.total_seats - stats.occupied_seats) %></div>
          <div style="font-size: 0.95rem; color: var(--text2); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Locuri Libere</div>
        </div>
      </div>
      <% } %>

      <!-- Circumscripție -->
      <div class="card" style="margin-bottom: 25px; border-radius: var(--r-lg); border-left: 5px solid var(--p600);">
        <div class="card-body" style="padding: 30px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--p100); color: var(--p700); display: flex; align-items: center; justify-content: center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h2 style="color: var(--p800); margin: 0; font-size: 1.4rem; font-weight: 700;">
              Elevii din circumscripția școlii
            </h2>
          </div>
          <p style="color: var(--text); line-height: 1.7; font-size: 1.05rem;">
            Toți copiii care au domiciliul în perimetrul (circumscripția) arondat Școlii Gimnaziale Nr. 2 Crețești au locul asigurat conform normelor Ministerului Educației. Părintele sau tutorele legal se prezintă la <strong>secretariatul școlii</strong> cu actele de identitate și certificatul de naștere al copilului pentru completarea cererii-tip de înscriere.
          </p>
        </div>
      </div>

      <!-- În afara circumscripției -->
      <div class="card" style="margin-bottom: 25px; border-radius: var(--r-lg); border-left: 5px solid var(--s500);">
        <div class="card-body" style="padding: 30px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: rgba(245, 158, 11, 0.15); color: var(--s600, #d97706); display: flex; align-items: center; justify-content: center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h2 style="color: var(--p800); margin: 0; font-size: 1.4rem; font-weight: 700;">
              Elevii din afara circumscripției
            </h2>
          </div>
          <p style="color: var(--text); line-height: 1.7; font-size: 1.05rem;">
            Pentru elevii care domiciliază în alte localități sau circumscripții, admiterea se realizează în a doua etapă, în limita locurilor rămase disponibile. Dosarele depuse sunt analizate și aprobate de <strong>Consiliul de Administrație</strong> al școlii pe baza criteriilor generale și specifice de departajare.
          </p>
        </div>
      </div>

      <!-- Documente necesare la înscriere -->
      <div class="card" style="margin-bottom: 35px; border-radius: var(--r-lg);">
        <div class="card-body" style="padding: 30px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 36px; height: 36px; border-radius: 8px; background: var(--p100); color: var(--p700); display: flex; align-items: center; justify-content: center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h2 style="color: var(--p800); margin: 0; font-size: 1.4rem; font-weight: 700;">
              Documente Necesare pentru Dosarul de Admitere
            </h2>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; color: var(--text); font-size: 1.05rem;">
            <li style="display: flex; align-items: flex-start; gap: 10px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--success, #10b981)" stroke-width="2.5" style="width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Cerere-tip de înscriere (disponibilă la secretariatul școlii sau la secțiunea Informații Publice)</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 10px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--success, #10b981)" stroke-width="2.5" style="width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Copie și original după certificatul de naștere al copilului</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 10px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--success, #10b981)" stroke-width="2.5" style="width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Copii după actele de identitate ale părinților / tutorilor legali</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 10px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--success, #10b981)" stroke-width="2.5" style="width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Adeverință medicală și fișa de vaccinări eliberate de medicul de familie</span>
            </li>
            <li style="display: flex; align-items: flex-start; gap: 10px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--success, #10b981)" stroke-width="2.5" style="width: 20px; height: 20px; flex-shrink: 0; margin-top: 3px;"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Documente justificative suplimentare (dacă este cazul: recomandare CJRAE, acte tutelă)</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Contact direct -->
      <div style="background: var(--p50); border: 1px dashed var(--p300); border-radius: var(--r-lg); padding: 25px; text-align: center;">
        <p style="color: var(--p900); font-size: 1.1rem; font-weight: 600; margin-bottom: 8px;">
          Aveți întrebări despre calendar sau documente?
        </p>
        <p style="color: var(--text2); margin-bottom: 18px;">
          Echipa secretariatului nostru vă stă la dispoziție în timpul programului de lucru.
        </p>
        <a href="/contact" class="btn btn-secondary">Contactează Secretariatul</a>
      </div>

    </div>
  </section>
</main>

<%- include('../partials/footer', { settings: locals.settings || {} }) %>
