<%- include('../partials/head') %>
  <%- include('../partials/header', { currentPage: 'admitere' }) %>

    <style>
      .subnav-elevi {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-bottom: 40px;
      }

      .subnav-elevi .btn {
        font-size: 0.95rem;
        padding: 8px 18px;
        border-radius: 999px;
      }

      .card-responsive {
        padding: 30px;
      }


        .docs-grid {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 24px;
          margin-bottom: 40px;
        }

        .doc-card {
          background: white;
          border: 1px solid var(--p200);
          border-radius: var(--r-xl);
          padding: 30px;
          box-shadow: var(--sh-md);
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .doc-card:hover {
          transform: translateY(-3px);
          box-shadow: var(--sh-lg);
        }

        .steps-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
          gap: 20px;
          margin-bottom: 40px;
        }

        @media (max-width: 768px) {
          .subnav-elevi {
            gap: 8px;
            margin-bottom: 30px;
          }

          .subnav-elevi .btn {
            font-size: 0.85rem;
            padding: 6px 14px;
          }

          .card-responsive {
            padding: 20px 16px;
          }


            .doc-card {
              padding: 22px 18px;
            }

            .docs-grid {
              grid-template-columns: 1fr;
              gap: 16px;
            }

            .steps-grid {
              grid-template-columns: 1fr;
              gap: 16px;
            }
          }
    </style>

    <main>
