<%- include('../partials/head') %>
<%- include('../partials/header', { currentPage: 'informatii-publice' }) %>

<main>
  <section class="page-header" style="background: linear-gradient(135deg, var(--p800), var(--p900)); color: white; padding: 100px 0 60px;">
    <div class="container text-center">
      <h1 class="reveal">Informații Publice</h1>
      <p class="reveal reveal-delay-1" style="font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 20px auto 0;">Regulamente, cereri tipizate și documente publice</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 800px;">
      
      <% if (!sections || sections.length === 0) { %>
        <div style="text-align: center; padding: 50px; background: white; border-radius: var(--r-lg); box-shadow: var(--sh-md);">
          <p style="font-size: 1.1rem; color: var(--text2);">Nu există documente publicate momentan.</p>
        </div>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 40px;">
          <% sections.forEach(section => { %>
            <div class="document-section">
              <h2 style="font-size: 1.75rem; color: var(--p800); margin-bottom: 10px; border-bottom: 2px solid var(--p200); padding-bottom: 10px;"><%= section.name %></h2>
              <% if (section.description) { %>
                <p style="color: var(--text2); margin-bottom: 20px;"><%= section.description %></p>
              <% } %>
              
              <% const docs = groupedDocuments[section.id] || []; %>
              <% if (docs.length === 0) { %>
                <p style="color: var(--text3); font-style: italic;">Niciun document în această secțiune.</p>
              <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 15px;">
                  <% docs.forEach(doc => { %>
                    <a href="<%= doc.url %>" target="_blank" class="card" style="display: block; text-decoration: none; transition: transform 0.3s ease, box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='var(--sh-lg)'" onmouseout="this.style.transform='none'; this.style.boxShadow='var(--sh-md)'">
                      <div class="card-body" style="display: flex; justify-content: space-between; align-items: center; padding: 20px;">
                        <h3 style="font-size: 1.25rem; color: var(--p700); margin: 0; font-weight: 600;"><%= doc.title %></h3>
                        <svg viewBox="0 0 24 24" fill="none" stroke="var(--p600)" stroke-width="2" style="width: 24px; height: 24px;"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
                      </div>
                    </a>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>

    </div>
  </section>
</main>

<%- include('../partials/footer', { settings: locals.settings || {} }) %>
