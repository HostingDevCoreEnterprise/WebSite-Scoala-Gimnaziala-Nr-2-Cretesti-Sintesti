<%- include('../partials/head') %>
<%- include('../partials/header', { currentPage: 'activitati-extra' }) %>

<main>
  <section class="page-header" style="background: linear-gradient(135deg, var(--p800), var(--p900)); color: white; padding: 100px 0 60px;">
    <div class="container text-center">
      <h1 class="reveal">Săptămâna Altfel / Verde</h1>
      <p class="reveal reveal-delay-1" style="font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 20px auto 0;">Excursii și activități benefice pentru dezvoltarea și relaxarea elevilor</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 50px;">
        <p style="font-size: 1.15rem; color: var(--text); line-height: 1.7;">
          Școala noastră organizează frecvent excursii, vizite la muzee și ateliere în aer liber în cadrul programelor <strong>Săptămâna Altfel</strong> și <strong>Săptămâna Verde</strong>. Credem că educația continuă dincolo de băncile școlii, ajutând elevii să descopere lumea și să se relaxeze.
        </p>
      </div>

      <div class="grid-2" style="gap: 30px;">
        <img src="/images/saptamana-altfel-verde1_878479.jpg" alt="Activitate extra" style="width: 100%; border-radius: var(--r-md); box-shadow: var(--sh-md);">
        <img src="/images/saptamana-altfel-verde2_125616.jpg" alt="Activitate extra" style="width: 100%; border-radius: var(--r-md); box-shadow: var(--sh-md);">
        <img src="/images/saptamana-altfel-verde3_168525.jpg" alt="Activitate extra" style="width: 100%; border-radius: var(--r-md); box-shadow: var(--sh-md);">
        <img src="/images/saptamana-altfel-verde4_120430.jpg" alt="Activitate extra" style="width: 100%; border-radius: var(--r-md); box-shadow: var(--sh-md);">
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer', { settings: locals.settings || {} }) %>
