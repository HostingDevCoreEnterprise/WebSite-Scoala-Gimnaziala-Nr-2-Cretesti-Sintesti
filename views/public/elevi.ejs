<%- include('../partials/head') %>
  <%- include('../partials/header', { currentPage: 'elevi' }) %>

    <main>
      <section class="page-header"
        style="background: linear-gradient(135deg, var(--p800), var(--p900)); color: white; padding: 100px 0 60px;">
        <div class="container text-center">
          <h1 class="reveal">Elevii Noștri</h1>
          <p class="reveal reveal-delay-1"
            style="font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 20px auto 0;">Fiecare elev este important
            pentru noi. Ne mândrim cu rezultatele și cu zâmbetele lor!</p>
        </div>
      </section>

      <section class="section">
        <div class="container">

          <!-- Subnavigation Elevi -->
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; margin-bottom: 50px;">
            <a href="/elevi" class="btn btn-primary"> Despre Elevi</a>
            <a href="/admitere" class="btn btn-secondary"> Admitere</a>
            <a href="/statutul-elevului" class="btn btn-secondary"> Statutul Elevului</a>
            <a href="/activitati-extra" class="btn btn-secondary"> Activități Extracuriculare</a>
            <a href="/absolvire" class="btn btn-secondary"> Absolvire</a>
            <a href="/evaluare-nationala" class="btn btn-secondary"> Evaluare Națională</a>
          </div>

          <!-- Secțiune Statutul Elevului -->
          <div class="card" style="margin-bottom: 50px; background: linear-gradient(135deg, rgba(29, 78, 216, 0.05), rgba(30, 64, 175, 0.02)); border: 1px solid var(--p200); border-radius: var(--r-xl); padding: 35px 30px; box-shadow: var(--sh-md);">
            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px;">
              <div style="flex: 1 1 500px;">
                <div style="display: inline-flex; align-items: center; gap: 8px; background: var(--p100); color: var(--p800); padding: 6px 14px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; margin-bottom: 15px;">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Ghidul Drepturilor și Responsabilităților
                </div>
                <h2 style="color: var(--p800); margin-bottom: 12px; font-weight: 800; font-size: 1.75rem;">Statutul Elevului</h2>
                <p style="color: var(--text2); line-height: 1.7; font-size: 1.05rem; margin-bottom: 15px;">
                  Comunitatea școlară funcționează pe baza respectului reciproc, a siguranței și a egalității de șanse. Consultă drepturile garantate elevilor, normele de conduită și rolul activ al Consiliului Elevilor.
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                  <a href="/statutul-elevului" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                    <span>Consultă Statutul Elevului</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 18px; height: 18px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
              </div>
              <div style="flex: 0 0 180px; text-align: center;">
                <div style="width: 100px; height: 100px; border-radius: 50%; background: var(--p100); color: var(--p700); display: inline-flex; align-items: center; justify-content: center; box-shadow: var(--sh-sm);">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="width: 50px; height: 50px;"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
              </div>
            </div>
          </div>

          <div class="grid-2" style="gap: 40px; margin-bottom: 40px;">
            <div>
              <img src="/images/elevi3_318273.jpg" alt="Elevi"
                style="width: 100%; border-radius: var(--r-md); box-shadow: var(--sh-md);">
            </div>
            <div style="display: flex; flex-direction: column; justify-content: center;">
              <h2 style="color: var(--p700); margin-bottom: 20px; font-weight: 700;">Dezvoltare armonioasă</h2>
              <p style="color: var(--text2); line-height: 1.7;">Ne dorim să creăm un mediu în care fiecare elev să se
                simtă respectat și încurajat. Punem accent nu doar pe dezvoltarea academică, ci și pe cea emoțională și
                socială.</p>
            </div>
          </div>

          <div class="grid-2" style="gap: 40px; margin-bottom: 40px;">
            <div style="display: flex; flex-direction: column; justify-content: center; order: 2;">
              <h2 style="color: var(--p700); margin-bottom: 20px; font-weight: 700;">Prețuim Performanța și
                Creativitatea</h2>
              <p style="color: var(--text2); line-height: 1.7;">Organizam activități care stimulează inteligența și
                imaginația elevilor, de la ateliere de creație, până la competiții sportive și concursuri școlare unde
                elevii noștri excelează în permanență.</p>
            </div>
            <div style="order: 1;">
              <img src="/images/elevi2_971069.jpg" alt="Elevi"
                style="width: 100%; border-radius: var(--r-md); box-shadow: var(--sh-md);">
            </div>
          </div>

          <div style="display: flex; justify-content: center; gap: 20px;">
            <img src="/images/elevi1_105559.jpg" alt="Elevi"
              style="width: 100%; max-width: 600px; border-radius: var(--r-md); box-shadow: var(--sh-md);">
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/footer', { settings: locals.settings || {} }) %>