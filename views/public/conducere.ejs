<%- include('../partials/head') %>
  <%- include('../partials/header', { currentPage: 'conducere' }) %>

    <main>
      <section class="page-header"
        style="background: linear-gradient(135deg, var(--p800), var(--p900)); color: white; padding: 100px 0 60px;">
        <div class="container text-center">
          <h1 class="reveal">Conducerea Școlii</h1>
          <p class="reveal reveal-delay-1"
            style="font-size: 1.25rem; opacity: 0.9; max-width: 600px; margin: 20px auto 0;">Director și Consiliul de
            Administrație</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div style="text-align: center; max-width: 800px; margin: 0 auto 50px;">
            <p style="font-size: 1.15rem; color: var(--text); line-height: 1.7;">
              Echipa de conducere a școlii are ca obiectiv principal menținerea unui mediu educațional sigur, de înaltă
              calitate, care să faciliteze dezvoltarea fiecărui elev. Consiliul de Administrație, format din profesori,
              părinți și reprezentanți ai autorităților locale, ia deciziile esențiale pentru bunul mers al instituției.
            </p>
          </div>

          <div class="grid-2" style="gap: 40px; align-items: center; margin-bottom: 60px;">
            <div style="order: 2;">
              <img src="/images/echipa1_722292.jpg" alt="Conducerea scolii"
                style="width: 100%; border-radius: var(--r-md); box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
            </div>
            <div style="order: 1;">
              <h2 style="color: var(--p700); margin-bottom: 20px; font-weight: 800; font-size: 2rem;">Viziune și
                Colaborare</h2>
              <p style="color: var(--text2); line-height: 1.8; margin-bottom: 15px; font-size: 1.1rem;">Directorul
                școlii, alături de Consiliul de Administrație, coordonează toate activitățile, asigurându-se că fiecare
                decizie este luată în interesul suprem al elevului.</p>
              <p style="color: var(--text2); line-height: 1.8; font-size: 1.1rem;">Colaborăm îndeaproape cu
                Inspectoratul Școlar pentru a implementa proiecte noi și a aduce dotări moderne, așa cum se va vedea în
                noul proiect de modernizare.</p>
            </div>
          </div>

          <div
            style="background: white; border-radius: var(--r-xl); padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); margin-bottom: 60px;">
            <h2
              style="color: var(--p800); text-align: center; margin-bottom: 40px; font-weight: 800; font-size: 1.8rem;">
              Echipa de Conducere</h2>

            <div class="grid-2" style="gap: 40px; align-items: stretch;">

              <!-- Text column -->
              <!-- Text column -->
              <div style="display: flex; flex-direction: column; gap: 20px;">
                
                <div class="grid-2" style="gap: 20px;">
                  <div style="background: var(--bg); padding: 25px; border-radius: var(--r-md); display: flex; align-items: center; gap: 20px; box-shadow: var(--sh-sm); border-left: 4px solid var(--p500);">
                    <div style="background: linear-gradient(135deg, var(--p500), var(--p700)); color: white; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 25px; height: 25px;">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                      </svg>
                    </div>
                    <div>
                      <h3 style="margin: 0; color: var(--p800); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.5px;">Director</h3>
                      <p style="margin: 5px 0 0; color: var(--text); font-size: 1.15rem; font-weight: 600;">Prof. Chira Elisabeta</p>
                    </div>
                  </div>

                  <div style="background: var(--bg); padding: 25px; border-radius: var(--r-md); display: flex; align-items: center; gap: 20px; box-shadow: var(--sh-sm); border-left: 4px solid var(--p400);">
                    <div style="background: linear-gradient(135deg, var(--p400), var(--p600)); color: white; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 25px; height: 25px;">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <polyline points="10 9 9 9 8 9" />
                      </svg>
                    </div>
                    <div>
                      <h3 style="margin: 0; color: var(--p800); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.5px;">Secretar</h3>
                      <p style="margin: 5px 0 0; color: var(--text); font-size: 1.15rem; font-weight: 600;">Ilinca Bianca</p>
                    </div>
                  </div>
                </div>

                <div style="background: var(--bg); padding: 30px; border-radius: var(--r-md); box-shadow: var(--sh-sm); flex-grow: 1;">
                  <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 25px;">
                    <div style="background: var(--p100); color: var(--p700); width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 22px; height: 22px;">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 00-3-3.87" />
                        <path d="M16 3.13a4 4 0 010 7.75" />
                      </svg>
                    </div>
                    <h3 style="margin: 0; color: var(--p800); font-size: 1.4rem;">Consiliul de Administrație</h3>
                  </div>
                  
                  <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 30px;">
                    <div style="background: var(--bg2); padding: 10px 18px; border-radius: 30px; font-size: 1rem; font-weight: 500; color: var(--p800); border: 1px solid var(--p200);">Calin Florentina</div>
                    <div style="background: var(--bg2); padding: 10px 18px; border-radius: 30px; font-size: 1rem; font-weight: 500; color: var(--p800); border: 1px solid var(--p200);">Neacsu Daniela</div>
                    <div style="background: var(--bg2); padding: 10px 18px; border-radius: 30px; font-size: 1rem; font-weight: 500; color: var(--p800); border: 1px solid var(--p200);">Decu Dumitru</div>
                  </div>
                  
                  <div class="grid-2" style="gap: 20px; padding-top: 20px; border-top: 1px solid var(--bdr);">
                    <div style="background: var(--p50); padding: 15px; border-radius: var(--r-sm); border-left: 3px solid var(--p400);">
                      <strong style="display: block; color: var(--p700); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px;">Secretar Consiliul de Administrație</strong>
                      <div style="color: var(--text); font-size: 1.05rem; font-weight: 600;">Lepadatu Elena</div>
                    </div>
                    <div style="background: var(--p50); padding: 15px; border-radius: var(--r-sm); border-left: 3px solid var(--accent);">
                      <strong style="display: block; color: var(--p700); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px;">Reprezentant Structura Sintești</strong>
                      <div style="color: var(--text); font-size: 1.05rem; font-weight: 600;">Genovia Ghita</div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Image column -->
              <div style="display: flex;">
                <img src="/images/echipa2_360618.jpg" alt="Echipa"
                  style="width: 100%; height: 100%; min-height: 400px; object-fit: cover; border-radius: var(--r-md); box-shadow: 0 10px 25px rgba(0,0,0,0.08);">
              </div>

            </div>
          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/footer', { settings: locals.settings || {} }) %>