<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Admin</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
</head>
<body>
<div class="admin-wrap">

  <!-- SIDEBAR -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-logo">
      <div class="admin-logo-row">
        <div class="admin-logo-box">
          <img src="/images/logo.png" alt="Logo" onerror="this.style.display='none';this.parentElement.innerHTML='S'" />
        </div>
        <div>
          <div class="admin-logo-name">Școala Gimnazială Nr. 2</div>
          <div class="admin-logo-sub">Portal Administrare</div>
        </div>
      </div>
    </div>

    <nav class="admin-nav">
      <p class="admin-nav-label">Principal</p>
      <a href="/admin"           class="admin-nav-link <%= currentSection==='dashboard' ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Dashboard
      </a>

      <p class="admin-nav-label">Conținut</p>
      <a href="/admin/anunturi"  class="admin-nav-link <%= currentSection==='anunturi'  ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
        Anunțuri
      </a>
      <a href="/admin/articole"  class="admin-nav-link <%= currentSection==='articole'  ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Articole (Blog)
      </a>
      <a href="/admin/comisii"   class="admin-nav-link <%= currentSection==='comisii'   ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        Comisii & Profesori
      </a>
      <a href="/admin/inscrieri" class="admin-nav-link <%= currentSection==='inscrieri' ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 00-8 0v2"/><circle cx="12" cy="7" r="4"/></svg>
        Locuri Înscrieri
      </a>
      <a href="/admin/evaluare" class="admin-nav-link <%= currentSection==='evaluare' ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Evaluare Națională
      </a>
      <a href="/admin/informatii-publice" class="admin-nav-link <%= currentSection==='informatii-publice' ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
        Informații Publice
      </a>
      <a href="/admin/mesaje" class="admin-nav-link <%= currentSection==='mesaje' ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Mesaje Contact
      </a>
      <p class="admin-nav-label">Configurare</p>
      <a href="/admin/setari"    class="admin-nav-link <%= currentSection==='setari'    ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Setări Site
      </a>
      <a href="/admin/utilizatori" class="admin-nav-link <%= currentSection==='utilizatori' ? 'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Utilizatori Admin
      </a>

      <p class="admin-nav-label">Site</p>
      <a href="/" target="_blank" class="admin-nav-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Vezi Site-ul
      </a>
    </nav>

    <div class="admin-sidebar-footer">
      <div class="admin-sidebar-user">
        <div class="admin-user-avatar"><%= user.display_name ? user.display_name.charAt(0).toUpperCase() : user.username.charAt(0).toUpperCase() %></div>
        <div>
          <div class="admin-user-name"><%= user.display_name || user.username %></div>
          <div class="admin-user-role">Administrator</div>
        </div>
      </div>
      <a href="/admin/logout" class="admin-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Deconectare
      </a>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="admin-main">
    <div class="admin-sidebar-overlay" id="adminOverlay"></div>
    <header class="admin-topbar">
      <div style="display:flex;align-items:center;gap:12px;">
        <button class="admin-mobile-toggle" id="adminToggle" aria-label="Meniu" style="padding: 6px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
        <h1 class="admin-page-title"><%= title %></h1>
      </div>
      <div class="admin-topbar-right">
        <a href="/" target="_blank" class="btn btn-secondary btn-sm"> Site public</a>
      </div>
    </header>

    <div class="admin-content">
      <% if (locals.flash) { %>
      <div class="flash flash-<%= flash.type %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <% if (flash.type === 'success') { %><polyline points="20 6 9 17 4 12"/><% } else { %><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/><% } %>
        </svg>
        <%= flash.message %>
      </div>
      <% } %>
