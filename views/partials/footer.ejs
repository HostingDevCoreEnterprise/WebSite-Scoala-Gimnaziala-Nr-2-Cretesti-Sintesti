<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand -->
      <div>
        <div class="footer-logo-wrap">
          <div class="footer-logo-box">
            <img src="/images/logo.png" alt="Logo"
              onerror="this.style.display='none';this.parentElement.innerHTML='S'" />
          </div>
          <span class="footer-school-name">
            <%= settings.school_name || 'Școala Gimnazială Nr. 2 Crețești-Sintești' %>
          </span>
        </div>
        <p class="footer-desc">Instituție de învățământ preuniversitar dedicată formării elevilor cu valori solide și
          competențe moderne.</p>
        <% if (settings.footer_extra) { %>
          <p class="footer-desc" style="margin-top:10px;">
            <%= settings.footer_extra %>
          </p>
          <% } %>
        <div style="display: flex; gap: 15px; margin-top: 20px;">
          <a href="https://www.facebook.com/people/Scoala-Gimnaziala-Nr-2-Cretesti-ILFOV/100089808318591/" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.05); color: #fff; transition: all 0.3s ease;" onmouseover="this.style.background='var(--dev-primary)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'" title="Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="/" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.05); color: #fff; transition: all 0.3s ease;" onmouseover="this.style.background='var(--dev-primary)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'" title="Website Oficial">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick links -->
      <div>
        <p class="footer-heading">Navigare</p>
        <nav class="footer-links">
          <a href="/" class="footer-link">Acasă</a>
          <a href="/anunturi" class="footer-link">Anunțuri</a>
          <a href="/articole" class="footer-link">Articole</a>
          <a href="/elevi" class="footer-link">Elevi</a>
          <a href="/profesori" footer-link">Profesori</a>
          <a href="/informatii-publice" class="footer-link">Informații Publice</a>
          <a href="/despre-scoala" class="footer-link">Despre</a>
          <a href="/contact" class="footer-link">Contact</a>
          <a href="/admin" class="footer-link" style="opacity:.6;">Portal Admin</a>
        </nav>
      </div>

      <!-- Col 3: Contact -->
      <div>
        <p class="footer-heading">Contact</p>
        <% if (settings.school_address) { %>
          <div class="footer-contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
              <circle cx="12" cy="9" r="2.5" />
            </svg>
            <span>
              <%= settings.school_address %>
            </span>
          </div>
          <% } %>
            <% if (settings.school_phone) { %>
              <div class="footer-contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path
                    d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
                </svg>
                <span>
                  <%= settings.school_phone %>
                </span>
              </div>
              <% } %>
                <% if (settings.school_email) { %>
                  <div class="footer-contact-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                      <polyline points="22,6 12,13 2,6" />
                    </svg>
                    <a href="mailto:<%= settings.school_email %>" style="color:rgba(255,255,255,.75)">
                      <%= settings.school_email %>
                    </a>
                  </div>
                  <% } %>
                    <% if (settings.school_schedule) { %>
                      <div class="footer-contact-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </svg>
                        <span>
                          <%= settings.school_schedule %>
                        </span>
                      </div>
                      <% } %>
      </div>
    </div>
  </div>

  <div class="footer-bottom" style="padding-top: 40px; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 40px;">
    <div class="container">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px;">
        <div style="max-width: 700px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); padding: 15px 25px; border-radius: var(--r-md); display: flex; align-items: center; gap: 20px; text-align: left; transition: all 0.3s ease;">
          <img src="/images/footer_badge_837492.png" alt="DevCore" style="width: 70px; height: 70px; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
          <div>
            <p style="font-size: 0.85rem; color: rgba(255,255,255,0.6); line-height: 1.5; margin-bottom: 5px;">
              Platforma web și arhitectura de securitate au fost dezvoltate de 
              <strong style="color: var(--white);">DevCore Enterprise</strong>.
            </p>
            <a href="/credite" style="font-size: 0.8rem; color: var(--p300); text-decoration: none; display: inline-flex; align-items: center; gap: 5px; font-weight: 500;">
              Descoperă DevCore Enterprise 
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 14px; height: 14px;"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <div style="font-size: 0.8rem; color: rgba(255,255,255,0.4); margin-top: 20px;">
          &copy; <%= new Date().getFullYear() %>
            <%= settings.school_name || 'Școala Gimnazială Nr. 2 Creței-Sintești' %>. Toate drepturile rezervate.
        </div>
      </div>
    </div>
  </div>
</footer>

<script src="/js/app.js"></script>
</body>

</html>