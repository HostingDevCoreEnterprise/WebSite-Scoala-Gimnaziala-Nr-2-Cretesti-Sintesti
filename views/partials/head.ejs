<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% const desc = typeof metaDesc !== 'undefined' ? metaDesc : 'Site oficial al Școlii Gimnaziale Nr. 2 Crețești-Sintești'; %>
  <meta name="description" content="<%= desc %>" />
  <title><%= title %></title>
  
  <!-- SEO Open Graph -->
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= desc %>" />
  <meta property="og:type" content="<%= typeof article !== 'undefined' ? 'article' : 'website' %>" />
  <meta property="og:image" content="<%= typeof article !== 'undefined' && article.featured_image ? 'https://scoalacretestisintesti.ro' + article.featured_image : 'https://scoalacretestisintesti.ro/images/logo.png' %>" />
  <% if (typeof article !== 'undefined') { %>
    <meta property="article:published_time" content="<%= new Date(article.published_at).toISOString() %>" />
    <meta property="article:author" content="Școala Gimnazială Nr. 2 Crețești-Sintești" />
    <meta property="article:section" content="<%= article.category || 'Noutăți' %>" />
  <% } %>
  <meta property="og:locale" content="ro_RO" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="<%= desc %>" />
  <meta name="twitter:image" content="<%= typeof article !== 'undefined' && article.featured_image ? 'https://scoalacretestisintesti.ro' + article.featured_image : 'https://scoalacretestisintesti.ro/images/logo.png' %>" />
  
  <!-- Theme Color & Manifest -->
  <meta name="theme-color" content="#1e3a8a" />
  
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="icon" type="image/png" href="/images/logo.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/images/logo.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/images/logo.png" />
  
  <!-- Structured Data (JSON-LD) -->
  <% if (typeof article !== 'undefined') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "<%= article.title %>",
    "image": [
      "<%= article.featured_image ? 'https://scoalacretestisintesti.ro' + article.featured_image : 'https://scoalacretestisintesti.ro/images/logo.png' %>"
    ],
    "datePublished": "<%= new Date(article.published_at).toISOString() %>",
    "dateModified": "<%= new Date(article.published_at).toISOString() %>",
    "author": [{
      "@type": "Organization",
      "name": "Școala Gimnazială Nr. 2 Crețești-Sintești",
      "url": "https://scoalacretestisintesti.ro"
    }]
  }
  </script>
  <% } else { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Școala Gimnazială Nr. 2 Crețești-Sintești",
    "description": "Site-ul oficial al școlii gimnaziale",
    "logo": "https://scoalacretestisintesti.ro/images/logo.png"
  }
  </script>
  <% } %>
</head>
<body>
