<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Autentificare Admin</title>
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="icon" type="image/png" href="/images/logo.png" />
</head>
<body>
<div class="login-page">
  <div class="login-bg-dots"></div>
  <div class="login-card">
    <div class="login-logo">
      <div class="login-logo-box">
        <img src="/images/logo.png" alt="Logo" onerror="this.style.display='none';this.parentElement.innerHTML='S'" />
      </div>
      <h1 class="login-title">Portal Admin</h1>
      <p class="login-sub">Autentifică-te pentru a gestiona site-ul școlii.</p>
    </div>

    <% if (locals.flash) { %>
    <div class="flash flash-<%= flash.type %>" style="margin-bottom:20px;">
      <%= flash.message %>
    </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group" style="margin-bottom:16px;">
        <label class="form-label" for="username">Utilizator</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="admin" required autocomplete="username" />
      </div>
      <div class="form-group" style="margin-bottom:24px;">
        <label class="form-label" for="password">Parolă</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
      </div>
      <button type="submit" class="btn btn-primary btn-full">Autentificare →</button>
    </form>

    <p style="text-align:center;margin-top:24px;font-size:.78rem;color:var(--text3);">
      <a href="/" style="color:var(--p600);">← Înapoi la site</a>
    </p>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
